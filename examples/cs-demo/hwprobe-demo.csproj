<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>hwprobe-demo</AssemblyName>
    <RootNamespace>HwDemo</RootNamespace>
  </PropertyGroup>
  <!-- 先在仓库根执行 cargo build release;构建示例时自动把 hwprobe.dll 拷到输出目录 -->
  <Target Name="CopyHwprobeDll" AfterTargets="Build" Condition="Exists('..\..\target\release\hwprobe.dll')">
    <Copy SourceFiles="..\..\target\release\hwprobe.dll" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
